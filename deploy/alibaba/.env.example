APP_DOMAIN=":80"
APP_URL="http://YOUR_SERVER_IP"

POSTGRES_USER="triangle"
POSTGRES_PASSWORD="replace-with-a-long-db-password"
POSTGRES_DB="triangle_invoice_os"
DATABASE_URL="postgresql://triangle:replace-with-a-long-db-password@postgres:5432/triangle_invoice_os?schema=public"

SESSION_SECRET="replace-with-a-long-random-session-secret"
FILE_STORAGE_DRIVER="database"

# OCR / AI classification
# Google Vision OCR accepts either an API key or service-account JSON.
GOOGLE_CLOUD_VISION_API_KEY=""
GOOGLE_APPLICATION_CREDENTIALS_JSON=""
OPENAI_API_KEY=""
OCR_AI_MODEL="gpt-4.1-nano"
