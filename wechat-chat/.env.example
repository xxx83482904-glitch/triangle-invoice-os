# Copy to .env. All paths resolve relative to wechat-chat/.
# Modes: mock / windows-uia (diagnostic only) / windows-ocr (manual review) / wxauto4 (read only) / wxautox4 (Plus).
# wxauto4 requires scripts/setup-wxauto4.ps1 and data/wxauto4.sqlite3.
# When changing modes, also use data/<mode>.sqlite3. Do not mix real and Mock data.
WECHAT_ADAPTER=mock
WECHAT_DB_PATH=data/mock.sqlite3
# Blank: create a random local token in .runtime/access-token.txt (never logged).
WECHAT_ACCESS_TOKEN=
WECHAT_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765,http://127.0.0.1:3100,http://localhost:3100
WECHAT_ALLOWED_HOSTS=127.0.0.1,localhost,::1
WECHAT_SECURE_COOKIE=false
# scripts/mobile-access.py records the HTTPS URL/access mode in .runtime/mobile.json.
# The app adds only that exact Host/Origin and marks HTTPS login cookies Secure.
# Optional custom config path (usually leave unset): WECHAT_MOBILE_CONFIG=
WECHAT_MOCK_INTERVAL=0
# Real adapter stays read-only. No production send path is enabled on unverified clients.
# wxauto4 uses at least 10 seconds and parses at most one new text per cycle.
WECHAT_UI_POLL_SECONDS=3
# Plus: optional setup-wxautox4.ps1, owner-run activate-wxautox4.ps1, separate data/wxautox4.sqlite3.
# Keep sending false until recipient binding and a consented real send are verified.
WECHAT_PLUS_SEND_ENABLED=false
# Each listener uses an independent WeChat window. This is NOT total-account coverage.
WECHAT_PLUS_MAX_LISTENERS=8
# Optional JSON array of preferred chat names, kept only in your private .env.
# Only uniquely observed sessions can be prioritized; this never forces a search.
WECHAT_PLUS_PREFERRED_CHATS=[]
WECHAT_PLUS_LANGUAGE=cn
# SDK client family and UI language are independent. Use WeChat for the international client.
WECHAT_PLUS_CLIENT_KIND=微信
# External AI is opt-in. Even when enabled, every request needs a preview and consent.
# Configure a Responses API / Structured Outputs compatible model you can access.
WECHAT_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
