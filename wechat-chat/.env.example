# Copy to .env. All paths resolve relative to wechat-chat/.
WECHAT_ADAPTER=mock
WECHAT_DB_PATH=data/mock.sqlite3
# Blank: create a random local token in .runtime/access-token.txt (never logged).
WECHAT_ACCESS_TOKEN=
WECHAT_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765,http://127.0.0.1:3100,http://localhost:3100
WECHAT_ALLOWED_HOSTS=127.0.0.1,localhost,::1
WECHAT_SECURE_COOKIE=false
# scripts/mobile-access.py records the HTTPS URL/access mode in .runtime/mobile.json.
# The app adds only that exact Host/Origin and marks HTTPS login cookies Secure.
# Optional custom config path (usually leave unset): WECHAT_MOBILE_CONFIG=
WECHAT_MOCK_INTERVAL=0
# Real adapter stays read-only. No production send path is enabled on unverified clients.
WECHAT_UI_POLL_SECONDS=3
