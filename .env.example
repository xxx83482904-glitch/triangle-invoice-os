DATABASE_URL="postgresql://triangle:triangle@localhost:5432/triangle_invoice_os?schema=public"
SESSION_SECRET="replace-with-a-long-random-secret"
APP_URL="http://localhost:3000"
FILE_STORAGE_DRIVER="local"

# OCR / AI classification
# Use either an API key, service-account JSON, or GOOGLE_APPLICATION_CREDENTIALS path for Google Vision.
GOOGLE_CLOUD_VISION_API_KEY=""
GOOGLE_APPLICATION_CREDENTIALS_JSON=""
OPENAI_API_KEY=""
OCR_AI_MODEL="gpt-5.4-mini"

# Optional self-deploy endpoint for trusted self-hosted deployments.
# Keep disabled unless the app runs in a private Docker/Synology environment.
# Self deploy works only when ALLOW_SELF_DEPLOY is "true" AND DEPLOY_TOKEN has 32+ characters (same value as the GitHub secret TRIANGLE_DEPLOY_TOKEN).
ALLOW_SELF_DEPLOY="false"
DEPLOY_TOKEN=""
DEPLOY_BRANCH="main"

# Money Forward Cloud Accounting V3. Server-side, read-only API client.
# Use a dedicated user with viewing permissions; never commit real API keys.
MONEYFORWARD_JAPAN_API_KEY=""
MONEYFORWARD_JAPAN_OFFICE_CODE=""
MONEYFORWARD_CHINA_API_KEY=""
MONEYFORWARD_CHINA_OFFICE_CODE=""

# Release accounts are created only when no account with the address exists. Leave empty on hosts whose users already exist.
RELEASE_ADMIN_EMAIL=""
RELEASE_ADMIN_PASSWORD=""
RELEASE_MAIL_EDITOR_EMAIL=""
RELEASE_MAIL_EDITOR_PASSWORD=""
